# Modelo do backend/.env, que o docker-compose.yml lê (env_file).
# Copie, preencha no próprio servidor e nunca versione o .env nem cole os valores em chat.
# DATABASE_URL e ALLOWED_ORIGINS vêm do docker-compose.yml.

# Segredo que assina o login (JWT). Obrigatório, com 32 caracteres ou mais: sem ele o backend não sobe.
# Gere com: openssl rand -hex 32
JWT_SECRET_KEY=

# S3 (opcional). Sem bucket, os arquivos vão para o disco.
AWS_S3_ENABLED=
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PUBLIC_BASE_URL=
